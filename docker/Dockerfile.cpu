# =============================================================================
# FALCONAge - the image
# =============================================================================
#
# Two targets from one file:
#
#   full (default)  Python, R and the falconage command. Tag: 1.0.0-cpu, latest
#   py              Python and the falconage command; reads CSV and TSV beta
#                   matrices, IDATs, GEO series and clinical tables, but not
#                   parquet or .h5ad.                  Tag: 1.0.0-py
#
# BUILD, from the repository root (the context must be the root, not docker/):
#   docker build -f docker/Dockerfile.cpu -t bhagesh/falconage:1.0.0-cpu .
#   docker build -f docker/Dockerfile.cpu --target py -t bhagesh/falconage:1.0.0-py .
#
# RUN. Nothing is baked in: no data, no credentials, no licensed weights.
#   docker run --rm -v "$PWD:/work" bhagesh/falconage:1.0.0-cpu run betas.csv
#
#   On Windows PowerShell replace "$PWD" with "${PWD}".
#
# WHY A PINNED BASE AND A LOCK FILE. Clock coefficients are fixed, but the
# arithmetic around them is not: a different BLAS changes the last bits of a
# 78,464-dimensional PC rotation. `latest` re-rolls that silently on every
# rebuild, so the base is pinned and Python packages come from python/uv.lock
# with hashes.
#
# WHY TWO STAGES FOR R. Some R packages compile on install, which needs a C
# compiler and development headers (about 0.5 GB). They are installed in a
# builder stage and only the finished library is copied into the image.
#
# ITERATING WITHOUT REBUILDING. Mount a checkout and set FALCONAGE_SOURCE; the
# entrypoint runs that tree instead of the installed copy.
#     -v "$PWD:/src:ro" -e FALCONAGE_SOURCE=/src
# -----------------------------------------------------------------------------

# ---- shared base --------------------------------------------------------------
FROM python:3.12-slim-bookworm AS os-base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # numpy is OpenMP-threaded. Left alone it takes every core on the host.
    # Override with -e OMP_NUM_THREADS=8.
    OMP_NUM_THREADS=4 \
    OPENBLAS_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    MPLBACKEND=Agg \
    # Writable whatever user the container runs as: a workflow manager runs it
    # as the host user (docker -u), whose uid has no home directory here.
    MPLCONFIGDIR=/tmp/matplotlib \
    XDG_CACHE_HOME=/tmp/.cache \
    # Downloads land here: Illumina manifests (12 to 26 MB each) and data
    # fetched with fa.download. Mount a volume over it to keep them.
    FALCONAGE_CACHE=/opt/falconage/cache \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Runtime libraries only; every Python wheel in the lock ships binary. procps
# provides `ps`, which Nextflow needs inside the container for task metrics.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 ca-certificates procps \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv==0.8.17

WORKDIR /opt/falconage

# Only the declaration, before any source, so editing the source does not
# re-download every dependency. The build fails if python/uv.lock is absent,
# which is intended: an unpinned image is not reproducible. If `uv export`
# fails to parse the lock after a `uv lock`, raise the uv pin to the version
# that wrote it (test/check_docker_lock.py checks the floor).
COPY python/pyproject.toml python/uv.lock /opt/falconage/python/

# ---- target: py -----------------------------------------------------------------
# The base install plus figures and spreadsheets. No R, no parquet, no AnnData.
FROM os-base AS py

RUN cd /opt/falconage/python \
 && uv export --frozen --no-dev --no-emit-project \
      --extra plot --extra metabolomics \
      --format requirements-txt > /tmp/requirements.txt \
 && pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt \
 && pip uninstall -y uv \
 && rm /tmp/requirements.txt

# --no-deps: everything the lock names is already installed above.
COPY python /opt/falconage/src/python
COPY docker/entrypoint.sh /opt/falconage/entrypoint.sh
RUN pip install --no-cache-dir --no-deps /opt/falconage/src/python \
 && rm -rf /opt/falconage/src \
 && chmod 0755 /opt/falconage/entrypoint.sh \
 && useradd --create-home --uid 1000 falcon \
 && mkdir -p /opt/falconage/cache /work \
 && chown -R falcon:falcon /opt/falconage/cache /work \
 && chmod 1777 /opt/falconage/cache \
 && mkdir -p /tmp/.cache/fontconfig /tmp/matplotlib && chmod -R 1777 /tmp/.cache /tmp/matplotlib

# A non-root user, so output written to a bind-mounted folder stays deletable
# by the person who ran the container.
USER falcon
VOLUME ["/opt/falconage/cache"]
WORKDIR /work
ENTRYPOINT ["/opt/falconage/entrypoint.sh"]
CMD ["--help"]
LABEL org.opencontainers.image.title="FALCONAge (Python only)" \
      org.opencontainers.image.source="https://github.com/bhagesh-h/FALCONAge" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.version="1.0.0"

# ---- R, with a compiler, used only to build the R library ---------------------
FROM python:3.12-slim-bookworm AS r-build

# Debian bookworm ships R 4.2.2, so the CRAN apt repository is added. The key is
# fetched by its full fingerprint, as published on
# https://cloud.r-project.org/bin/linux/debian/ (rotated 2026-11-19); a short ID
# can collide on a keyserver.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates gnupg dirmngr \
 && gpg --batch --keyserver keyserver.ubuntu.com --recv-keys 0xBA4EE5DE858FFFA7CFD8563908FC7B745769E9E4 \
 && gpg --batch --export 0xBA4EE5DE858FFFA7CFD8563908FC7B745769E9E4 > /usr/share/keyrings/cran.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/cran.gpg] https://cloud.r-project.org/bin/linux/debian bookworm-cran40/" \
      > /etc/apt/sources.list.d/cran.list \
 && apt-get update && apt-get install -y --no-install-recommends \
        r-base-core r-base-dev \
        libcurl4-openssl-dev libssl-dev libxml2-dev \
        libfontconfig1-dev libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev \
        libharfbuzz-dev libfribidi-dev libuv1-dev \
    && rm -rf /var/lib/apt/lists/*

# A dated Posit snapshot: binary packages and a fixed resolution, so a rebuild
# in six months gets the same ggplot2. install_deps.R reads r/DESCRIPTION, so
# the image can never install a different set than the package declares.
ENV R_REPOS=https://packagemanager.posit.co/cran/__linux__/bookworm/2026-08-01
COPY r/DESCRIPTION /opt/falconage/r/DESCRIPTION
COPY docker/install_deps.R /opt/falconage/install_deps.R
RUN Rscript /opt/falconage/install_deps.R /opt/falconage/r/DESCRIPTION
COPY r /opt/falconage/src/r
RUN R CMD INSTALL --no-multiarch /opt/falconage/src/r

# ---- target: full (default) ---------------------------------------------------
FROM os-base AS full

# R itself and the shared libraries the compiled R packages link against. No
# compiler and no headers.
COPY --from=r-build /usr/share/keyrings/cran.gpg /usr/share/keyrings/cran.gpg
COPY --from=r-build /etc/apt/sources.list.d/cran.list /etc/apt/sources.list.d/cran.list
RUN apt-get update && apt-get install -y --no-install-recommends \
        r-base-core \
        libcurl4 libssl3 libxml2 \
        libfontconfig1 libfreetype6 libpng16-16 libtiff6 libjpeg62-turbo \
        libharfbuzz0b libfribidi0 libuv1 \
    && rm -rf /var/lib/apt/lists/*

RUN cd /opt/falconage/python \
 && uv export --frozen --no-dev --no-emit-project \
      --extra methylation --extra plot --extra anndata --extra metabolomics --extra learn \
      --format requirements-txt > /tmp/requirements.txt \
 && pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt \
 && pip uninstall -y uv \
 && rm /tmp/requirements.txt

COPY --from=r-build /usr/local/lib/R/site-library /usr/local/lib/R/site-library
COPY python /opt/falconage/src/python
COPY docker/entrypoint.sh /opt/falconage/entrypoint.sh
RUN pip install --no-cache-dir --no-deps /opt/falconage/src/python \
 && rm -rf /opt/falconage/src \
 && chmod 0755 /opt/falconage/entrypoint.sh

# reticulate must find the interpreter that already has the core installed.
ENV RETICULATE_PYTHON=/usr/local/bin/python

RUN useradd --create-home --uid 1000 falcon \
 && mkdir -p /opt/falconage/cache /work \
 && chown -R falcon:falcon /opt/falconage/cache /work \
 && chmod 1777 /opt/falconage/cache \
 && mkdir -p /tmp/.cache/fontconfig /tmp/matplotlib && chmod -R 1777 /tmp/.cache /tmp/matplotlib
USER falcon

VOLUME ["/opt/falconage/cache"]
WORKDIR /work
ENTRYPOINT ["/opt/falconage/entrypoint.sh"]
CMD ["--help"]

# Last, so that changing a label rebuilds one layer instead of the image.
# test/check_versions.py reads the version label.
LABEL org.opencontainers.image.title="FALCONAge" \
      org.opencontainers.image.description="Biological age and aging-clock scoring from multiomic data, in Python and R" \
      org.opencontainers.image.source="https://github.com/bhagesh-h/FALCONAge" \
      org.opencontainers.image.url="https://bhagesh-h.github.io/FALCONAge/" \
      org.opencontainers.image.documentation="https://bhagesh-h.github.io/FALCONAge/" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.base.name="python:3.12-slim-bookworm"
